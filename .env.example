# Copy to .env. create-github-app.py fills in everything except DEMO_REPO.
DEMO_REPO=your-user/dr-demo-app
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=.secrets/github-app.pem
SMEE_URL=
# The deploy secret both pipelines need (synced to GitHub Secrets AND the cluster).
DEMO_API_KEY=
